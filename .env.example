# Copy to .env.local for local development.
# Vercel defaults to browser; local development defaults to local SQLite.
# Set this public build option to browser to test the hosted behavior locally.
# VITE_DATA_MODE=browser
TURSO_DATABASE_URL=file:local.sqlite
# Leave unset for local SQLite. Required for a remote Turso database.
# TURSO_AUTH_TOKEN=
# Optional authenticated HTTP collector. The local ispu:collect command needs no secret.
# CRON_SECRET=
